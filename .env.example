# Copy to .env (Git ignores it) and set the values for this machine. Read by tools/build.sh and mirror/release.sh.

# WSL path of ext/kennel in the Hundekraft source that matches the OP-1's core
HUNDEKRAFT_KENNEL=/mnt/d/path/to/hundekraft-3.2.3-source/ext/kennel

# WSL distribution with the bfin-elf toolchain (tools/build-bfin-toolchain.sh)
OP1_WSL_DISTRO=Ubuntu-24.04

# For mirror/release.sh: Windows path of the Android signing keystore. Keep its password (OP1_KEYSTORE_PASS) out of
# this file and set it only in the shell that runs the release.
#OP1_KEYSTORE=C:/path/to/op1mirror.keystore
